# Copy this file to .env for local development
# On Vercel: add these in Project Settings → Environment Variables

# Required — free key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Required for AI chatbot — free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Anthropic Claude (paid, higher accuracy)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Tesseract path on Windows (auto-detected if installed)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Set automatically by Vercel — do not set manually
# VERCEL=1
